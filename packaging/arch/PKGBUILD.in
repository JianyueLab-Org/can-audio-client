# CI 按发布版本填好 @VERSION@ / @SHA256@，作为 Release 附件发布。用法：下载 PKGBUILD 后 makepkg -si
pkgname=can-audio-client-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='CAN 管制语音客户端（Avalonia 界面 + 打包语音引擎）'
arch=('x86_64')
url='https://github.com/JianyueLab-Org/can-audio-client'
license=('custom')
depends=('glibc' 'zlib' 'icu' 'fontconfig' 'libx11' 'libice' 'libsm' 'alsa-lib')
optdepends=('noto-fonts-cjk: 中文界面字体'
            'pipewire-alsa: 经 PipeWire 录音和播放'
            'sdl2: 随包的 SDL2 不可用时供摇杆 PTT 使用')
provides=('can-audio-client')
conflicts=('can-audio-client')
options=('!strip' '!debug')   # 单文件程序和 PyInstaller 包在末尾附带数据，strip 会把它们剥坏
install=can-audio-client.install
source=("https://github.com/JianyueLab-Org/can-audio-client/releases/download/v${pkgver}/can-audio-client-${pkgver}-linux-x64.tar.gz"
        'can-audio-client.install')
sha256sums=('@SHA256@'
            '@INSTALL_SHA256@')

package() {
    local src="$srcdir/can-audio-client-${pkgver}-linux-x64"
    install -d "$pkgdir/opt/can-audio-client/controller" "$pkgdir/usr/bin"
    install -m755 "$src/ControllerClient" "$pkgdir/opt/can-audio-client/"
    install -m755 "$src/controller/can-voice" "$pkgdir/opt/can-audio-client/controller/"
    install -m644 "$src/controller/voice-engine.txt" "$pkgdir/opt/can-audio-client/controller/"
    ln -s /opt/can-audio-client/ControllerClient "$pkgdir/usr/bin/can-audio-client"
    install -Dm644 "$src/can-audio-client.desktop" "$pkgdir/usr/share/applications/can-audio-client.desktop"
    install -Dm644 "$src/can-audio-client.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/can-audio-client.png"
    install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/can-audio-client/README.md"
    if [ -f "$src/RNNOISE-COPYING" ]; then
        install -Dm644 "$src/RNNOISE-COPYING" "$pkgdir/usr/share/licenses/$pkgname/RNNOISE-COPYING"
    fi
}
