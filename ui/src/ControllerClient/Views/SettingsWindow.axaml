<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControllerClient.ViewModels"
        xmlns:views="using:ControllerClient.Views"
        x:Class="ControllerClient.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="580" Height="460"
        WindowDecorations="None"
        BorderBrush="{DynamicResource Brush.Border.Control}"
        BorderThickness="1"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!--
    对应 AFV SettingsForm（固定对话框）：各分组改为左侧菜单，右侧为当前设置面板，
    底部右对齐 确定 / 应用 / 取消。
    打开时主窗口蒙上遮罩变暗，以区分当前操作的窗口。
  -->
  <DockPanel>
    <views:TitleBar DockPanel.Dock="Top" Title="设置" />

    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space.Sm}">
        <Button Content="确定" Classes="primary" MinWidth="72" Click="OnOkClick" />
        <Button Content="应用" MinWidth="72" IsEnabled="{Binding IsDirty}" Click="OnApplyClick" />
        <Button Content="取消" MinWidth="72" IsCancel="True" Click="OnCancelClick" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="150,*">
      <!-- 左侧菜单：AFV 设置窗口中的各个分组 -->
      <Border Classes="sidebar" Padding="0,8">
        <ListBox x:Name="Menu" SelectionChanged="OnMenuSelectionChanged">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Theme" Value="{DynamicResource NavItemTheme}" />
            </Style>
          </ListBox.Styles>
          <ListBoxItem Content="用户信息" Tag="User" />
          <ListBoxItem Content="音频" Tag="Audio" />
          <ListBoxItem Content="按键通话 (PTT)" Tag="Ptt" />
          <ListBoxItem Content="UniATIS（未接入）" Tag="UniAtis" IsEnabled="False" />
          <ListBoxItem Content="Stream Deck（未接入）" Tag="StreamDeck" IsEnabled="False" />
        </ListBox>
      </Border>

      <!-- 右侧面板 -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="PanelHost" Margin="{DynamicResource Padding.Panel}" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
